# Copy to .env (local dev) or set in the Railway/Render dashboard.
# Only HARNESS_ACCESS_CODE is needed for a basic run; everything else is opt-in.

# --- core ---
HARNESS_ACCESS_CODE=            # gate for the UI + API (empty = open)
HARNESS_WORKDIR=                # agent sandbox dir (default ~/harness-work)
PORT=8000

# --- model routing ---
HORDE_API_KEY=                  # optional: better AI Horde queue priority
DEEPINFRA_API_KEY=              # uncensored: dolphin models
TOGETHER_API_KEY=               # uncensored: dolphin models
OPENROUTER_API_KEY=             # uncensored: hermes models
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
FIREWORKS_API_KEY=
HF_TOKEN=
COHERE_API_KEY=
GRATISFY_API_KEY=

# --- native integrations (app/integrations.py) ---
GITHUB_TOKEN=                   # github_api tool
GITLAB_TOKEN=                   # gitlab_api tool
GITLAB_HOST=                    # default https://gitlab.com
GOOGLE_OAUTH_CLIENT_ID=         # gmail tool (needs Jay's one-time Google connect)
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
VERCEL_TOKEN=                   # vercel_api tool
VERCEL_TEAM_ID=                 # optional
FAL_KEY=                        # fal_generate tool
FAL_IMAGE_MODEL=                # default fal-ai/flux-2-dev
